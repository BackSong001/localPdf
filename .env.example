# =============================================================================
# localPdf 환경변수 샘플
# 사용법: cp .env.example .env  후 값을 채운 뒤 실행
# 주의: .env 는 절대 커밋하지 마세요.
# =============================================================================

# -----------------------------------------------------------------------------
# 서버
# -----------------------------------------------------------------------------
# 로컬 전용 바인딩. 외부 노출이 필요하면 보안 경고를 확인하세요.
LOCALPDF_HOST=127.0.0.1
LOCALPDF_PORT=8000

# Job 임시 디렉터리 루트. 비우면 OS 임시 디렉터리 사용.
LOCALPDF_TEMP_DIR=

# 개발용 CORS 허용 오리진 (쉼표 구분)
LOCALPDF_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# -----------------------------------------------------------------------------
# 제한값 (바이트 단위)
# -----------------------------------------------------------------------------
LOCALPDF_MAX_FILES=1000
LOCALPDF_MAX_IMAGE_BYTES=52428800          # 50 MiB
LOCALPDF_MAX_TOTAL_BYTES=2147483648        # 2 GiB
LOCALPDF_MAX_PDF_BYTES=104857600           # 100 MiB
LOCALPDF_MAX_PDF_PAGES=2000

# 완료 후 Job 보존 시간(초) 및 정리 주기(초)
LOCALPDF_JOB_TTL_SECONDS=3600              # 1시간
LOCALPDF_CLEANUP_INTERVAL_SECONDS=600      # 10분

# -----------------------------------------------------------------------------
# 프론트엔드 (Vite)
# -----------------------------------------------------------------------------
# 개발 시에는 Vite 프록시(/api)를 사용하므로 비워도 됩니다.
# 프로덕션에서 API 서버가 다른 포트/호스트이면 지정하세요.
VITE_API_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# LLM (v2 요약 기능 전용 — v1에서는 사용하지 않음)
# -----------------------------------------------------------------------------
# provider 선택: gemini | nvidia
LLM_PROVIDER=gemini

# Gemini API 키 발급: https://aistudio.google.com/app/apikey
# 모델 목록: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# NVIDIA NIM API 키 발급: https://build.nvidia.com/
# API 문서: https://docs.api.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# -----------------------------------------------------------------------------
# 참고 링크
# -----------------------------------------------------------------------------
# FastAPI:        https://fastapi.tiangolo.com/
# PyMuPDF:        https://pymupdf.readthedocs.io/
# Pillow:         https://pillow.readthedocs.io/
# Vite:           https://vitejs.dev/
# React:          https://react.dev/
# pytest:         https://docs.pytest.org/
# ruff:           https://docs.astral.sh/ruff/
